# Local E2E environment matching docker-compose/compose.keycloak.yml's Keycloak
# front-channel host (localhost), used by scripts/e2e-local.sh to run the Next.js
# dev server on the host while dependencies (Keycloak, BaSyx, proxy, generator)
# run in Docker. Values are the same non-secret demo defaults used throughout
# docker-compose/*.yml - do not put real secrets in this file.
AAS_REPO_API_URL=http://localhost:5065/repo
SUBMODEL_REPO_API_URL=http://localhost:5065/repo
CONCEPT_DESCRIPTION_REPO_API_URL=http://localhost:5065/repo
SERIALIZATION_API_URL=http://localhost:5065/repo
DISCOVERY_API_URL=http://localhost:5065/discovery
REGISTRY_API_URL=http://localhost:5065/registry
SUBMODEL_REGISTRY_API_URL=http://localhost:5065/registry
MNESTIX_AAS_GENERATOR_API_URL=http://localhost:5065
MNESTIX_BACKEND_API_KEY=verySecureApiKey
AAS_LIST_FEATURE_FLAG=true
TRANSFER_FEATURE_FLAG=false
COMPARISON_FEATURE_FLAG=true
AUTHENTICATION_FEATURE_FLAG=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=verySecureNextAuthSecret
SECRET_ENC_KEY=J+mMxwKo+aoFJ6uxMv6Acv54buuBir2EJ3z6LGFB+Vo=
KEYCLOAK_ENABLED=true
KEYCLOAK_CLIENT_ID=mnestix-browser-client-demo
KEYCLOAK_ISSUER=http://localhost:8080
KEYCLOAK_LOCAL_URL=http://localhost:8080
KEYCLOAK_REALM=Mnestix
IMPRINT_URL=
DATA_PRIVACY_URL=
