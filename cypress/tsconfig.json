{
  "compilerOptions": {
    "module": "preserve",
    "target": "es2017",
    "lib": ["dom", "es2017"],
    "jsx": "react",
    "allowJs": true,
    "types": ["cypress", "node"],
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["legacy"]
}
